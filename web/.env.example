# Optional. Without it, drafts come from the built-in template.
ANTHROPIC_API_KEY=

# Optional. A Stripe TEST key (sk_test_...) turns the simulated hold into a real
# Stripe Connect test-mode hold: Checkout with manual capture, Express payee onboarding.
STRIPE_SECRET_KEY=

# Optional. Our own open-weight model on GMI Cloud's inference engine (OpenAI-compatible).
# When set, the intake form offers "Draft on our own model" and the story is not sent to Claude.
GMI_API_KEY=
GMI_MODEL=
# GMI_BASE_URL=https://api.gmi-serving.com/v1
